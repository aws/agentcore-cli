{
  "name": "ProtocolTesting",
  "version": 1,
  "agents": [
    {
      "type": "AgentCoreRuntime",
      "name": "MCPProtocol",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/MCPProtocol/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocolMode": "MCP"
    },
    {
      "type": "AgentCoreRuntime",
      "name": "A2AAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/A2AAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "modelProvider": "Bedrock",
      "protocolMode": "A2A"
    },
    {
      "type": "AgentCoreRuntime",
      "name": "RegularHTTPAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/RegularHTTPAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "modelProvider": "Gemini",
      "protocolMode": "HTTP"
    }
  ],
  "memories": [
    {
      "type": "AgentCoreMemory",
      "name": "A2AAgentMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaces": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaces": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaces": [
            "/summaries/{actorId}/{sessionId}"
          ]
        }
      ]
    }
  ],
  "credentials": [
    {
      "type": "ApiKeyCredentialProvider",
      "name": "ProtocolTestingGemini"
    }
  ]
}