exports[`project add runtime an S3 bucket mount is written to the spec entry 1`] = `
{
  "build": "CodeZip",
  "codeLocation": "app/s3_agent",
  "entrypoint": "main.py",
  "filesystemConfigurations": [
    {
      "s3BucketMount": {
        "bucket": "amzn-s3-demo-bucket",
        "mountPath": "/mnt/data",
        "prefix": "sessions/{runtimeSessionId}/",
        "s3BucketOwner": "123456789012",
        "s3BucketRegion": "us-west-2",
      },
    },
  ],
  "name": "s3_agent",
  "platformVersion": "V2",
  "protocol": "HTTP",
  "runtimeVersion": "PYTHON_3_14",
}
`;
