FROM public.ecr.aws/docker/library/python:3.12-slim-trixie

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

ARG UV_DEFAULT_INDEX
ARG UV_INDEX

WORKDIR /app

ENV UV_SYSTEM_PYTHON=1 \
    UV_NO_CACHE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_PROGRESS=1 \
    PYTHONUNBUFFERED=1 \
    DOCKER_CONTAINER=1 \
    UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX} \
    UV_INDEX=${UV_INDEX} \
    PATH="/app/.venv/bin:$PATH"

RUN useradd -m -u 1000 bedrock_agentcore

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY --chown=bedrock_agentcore:bedrock_agentcore . .
RUN uv sync --frozen --no-dev && /usr/local/bin/python -m pip uninstall -y uv

# box, from the staged folder, which build and deploy stage: box, its two helpers and its packs, from
# the box release (Linux arm64) that box.version in agentcore.json names, checked against its
# SHA-256; and the AgentCore Runtime box profile with the policy files it names. `agentcore dev`
# stages the project's .box/profile.toml into .box-dev/ instead and names it with BOX_DIST, so it
# never overwrites what build and deploy staged. The folder is copied whole, so each policy file
# stays beside the profile. start.sh runs box with the profile's path, outside /app, the workspace.
ARG BOX_DIST=.box-dist
COPY ${BOX_DIST}/ /opt/box/
RUN /opt/box/box --version
COPY start.sh /opt/box/
# box creates /app/.box at each run on Linux, so the agent's user owns /app itself. The staged copies
# in /app are not the agent's, so they go.
RUN rm -rf /app/.box-dist /app/.box-dev \
    && chmod 0755 /opt/box/start.sh \
    && chown bedrock_agentcore:bedrock_agentcore /app
USER bedrock_agentcore

# AgentCore Runtime service contract ports
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/runtime-service-contract.html
# 8080: HTTP Mode
# 8000: MCP Mode
# 9000: A2A Mode
EXPOSE 8080 8000 9000

# start.sh starts box in /app; box listens on 8080 and runs the agent in its sandbox on 8081.
ENTRYPOINT ["/opt/box/start.sh"]
