FROM public.ecr.aws/docker/library/python:3.12-slim-trixie

# curl downloads box from the box release below.
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

ARG UV_DEFAULT_INDEX
ARG UV_INDEX

WORKDIR /app

ENV UV_SYSTEM_PYTHON=1 \
    UV_NO_CACHE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_PROGRESS=1 \
    PYTHONUNBUFFERED=1 \
    DOCKER_CONTAINER=1 \
    UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX} \
    UV_INDEX=${UV_INDEX} \
    PATH="/app/.venv/bin:$PATH"

RUN useradd -m -u 1000 bedrock_agentcore

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY --chown=bedrock_agentcore:bedrock_agentcore . .
RUN uv sync --frozen --no-dev && /usr/local/bin/python -m pip uninstall -y uv

USER bedrock_agentcore

# box, from the box release (Linux arm64): download the archive from its public GitHub release, check
# its pinned SHA-256 and unpack box, its two helpers and its packs into /opt/box. The box profile
# comes from .box-dist/, which dev, build and deploy stage: dev the project's .box/profile.toml,
# build and deploy the AgentCore Runtime profile. start.sh runs box with the profile's path, outside
# /app, the workspace.
USER root
ARG BOX_REPO={{box.repo}}
ARG BOX_VERSION={{box.version}}
ARG BOX_SHA256={{box.sha256}}
RUN set -eu; \
    curl -fsSL --retry 3 -o /tmp/box.tar.gz \
      "https://github.com/${BOX_REPO}/releases/download/v${BOX_VERSION}/box-v${BOX_VERSION}-aarch64-unknown-linux-gnu.tar.gz"; \
    echo "${BOX_SHA256}  /tmp/box.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/box; \
    tar -C /opt/box -xzf /tmp/box.tar.gz --no-same-owner; \
    rm /tmp/box.tar.gz; \
    /opt/box/box --version
COPY start.sh /opt/box/
COPY .box-dist/profile.toml /opt/box/profile.toml
# box creates /app/.box at each run on Linux, so the agent's user owns /app itself. The staged copy in
# /app/.box-dist is not the agent's, so it goes.
RUN rm -rf /app/.box-dist \
    && chmod 0755 /opt/box/start.sh \
    && chown bedrock_agentcore:bedrock_agentcore /app
USER bedrock_agentcore

# AgentCore Runtime service contract ports
# https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/runtime-service-contract.html
# 8080: HTTP Mode
# 8000: MCP Mode
# 9000: A2A Mode
EXPOSE 8080 8000 9000

# start.sh starts box in /app; box listens on 8080 and runs the agent in its sandbox on 8081.
ENTRYPOINT ["/opt/box/start.sh"]
