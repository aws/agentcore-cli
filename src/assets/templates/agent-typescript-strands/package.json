    "start": "node dist/main.js",
    "dev": "tsx watch main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.25.2",
    "@opentelemetry/api": "~1.9.0",
    "@strands-agents/sdk": "~1.5.0",
    "bedrock-agentcore": "~0.3.0",
    "tsx": "~4.19.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/node": "~22.0.0",
    "typescript": "~5.6.0"
  },
  "overrides": {
    "bedrock-agentcore": {
      "@strands-agents/sdk": "$@strands-agents/sdk"
    }
  }
}
